# Base de Datos
DATABASE_URL="postgresql://usuario:contraseña@localhost:5432/caja_clinica"

# Autenticación JWT
JWT_SECRET="tu_clave_secreta_super_segura_min_32_caracteres_de_largo"

# CORS - Orígenes permitidos (separados por comas)
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"

# Modo de autenticación
# Si DISABLE_AUTH=true, la autenticación se deshabilita (SOLO DESARROLLO)
DISABLE_AUTH=false

# WhatsApp Integration
# Habilitar o deshabilitar WhatsApp
WHATSAPP_ENABLED=false

# Número de negocio (ejemplo: +51987654321)
# Usar formato internacional con +
WHATSAPP_NUMERO_NEGOCIO="+51987654321"

# Números de teléfono de los dueños/gerentes para recibir reportes
# Separar múltiples números con comas
# Ejemplos: +51987654321,+51987654322,+51987654323
WHATSAPP_GERENTES="+51987654321,+51987654322"

# Proveedor de API WhatsApp
# Opciones: 'twilio' | 'whatsapp_business' | 'dummy'
# - dummy: modo simulado para testing (sin envío real)
# - twilio: requiere TWILIO_ACCOUNT_SID y TWILIO_AUTH_TOKEN
# - whatsapp_business: requiere credenciales de WhatsApp Business API
WHATSAPP_PROVIDER="dummy"

# Credenciales de Twilio (si usas WHATSAPP_PROVIDER=twilio)
# Obtén en: https://www.twilio.com/console
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="+15551234567"

# Variables adicionales para futuras integraciones
NODE_ENV="development"
PORT=3000
