# Database connection string for PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/caja_clinica?schema=public"

# JWT secret used for authentication
JWT_SECRET="change_this_secret_to_a_secure_random_value"

# API port
PORT=3000

# Allowed frontend origins for CORS, comma separated
CORS_ORIGIN="http://localhost:5173"

# Only for local development when explicitly needed
DISABLE_AUTH=false
